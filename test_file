// Update these pin numbers to match where your wires are connected!
const int numButtons = 10;
const int buttonPins[numButtons] = {2, 3, 4, 5, 6, 7, 8, 9, 15, 16};

const int numKnobs = 5;
const int knobPins[numKnobs] = {A0, A1, A2, A3, A10};

void setup() {
  Serial.begin(9600);
  
  // Set up button pins with internal pull-up resistors
  for (int i = 0; i < numButtons; i++) {
    pinMode(buttonPins[i], INPUT_PULLUP);
  }
}

void loop() {
  // 1. Read and print Knob values (0 to 1023)
  Serial.print("KNOBS: ");
  for (int i = 0; i < numKnobs; i++) {
    Serial.print("K");
    Serial.print(i + 1);
    Serial.print(": ");
    Serial.print(analogRead(knobPins[i]));
    Serial.print("\t");

  }

  // 2. Read and print Button states (PRESSED or RELEASED)
  Serial.print(" | BUTTONS: ");
  for (int i = 0; i < numButtons; i++) {
    Serial.print("B");
    Serial.print(i + 1);
    Serial.print(": ");
    if (digitalRead(buttonPins[i]) == LOW) {
      Serial.print("[PRESSED] ");
    } else {
      Serial.print("--- ");
    }
    //delay(20); // 20ms debounce delay keeps button reads reliable
  }

  Serial.println();
  delay(150); // Refresh rate
}
